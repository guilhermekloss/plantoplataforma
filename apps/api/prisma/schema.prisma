// schema.prisma — Plantor MVP (Fase 01)
//
// Campos de blockchain (blockchainTxHash, blockchainNetwork, blockchainContractAddr)
// e de arquivo (fileUrl/fileHash) existem mas ficam NULL no MVP. O model
// BlockchainRecord é criado mas não populado nesta fase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Connection pooling (Supabase pgBouncer / Railway) usado em runtime
  url       = env("DATABASE_URL")
  // Conexão direta usada por `prisma migrate` (Supabase)
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                String   @id @default(cuid())
  tenantId          String   @unique // mesmo que id para MVP
  type              OrgType // cooperative | trading | producer
  name              String
  legalName         String?
  cnpj              String?  @unique
  cpf               String?  @unique // pessoa física (produtor)
  stateRegistration String?
  carNumber         String? // Cadastro Ambiental Rural
  email             String   @unique
  phone             String?
  whatsappNumber    String?
  address           Json? // { street, city, state, zip, country } — opcional no cadastro
  bankAccount       Json? // { bank, agency, account, pixKey }

  // Perfil da propriedade (produtor) — uso do solo
  // { totalHa, arableHa, pastureHa, reserveHa }
  farmProfile Json?

  // Pecuária (fazenda mista) — rebanho recebido de brincos/balança (SISBOV)
  // { herd: [{ category, headCount, breed, avgWeightKg, gmdKgDay }], pastureHa, source }
  livestock Json?
  plan              PlanType @default(trial)
  planExpiresAt     DateTime?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  users             User[]
  contractsAsSeller Contract[]     @relation("seller")
  contractsAsBuyer  Contract[]     @relation("buyer")
  fieldReadings     FieldReading[]
  offers            Offer[]        @relation("offerSeller")
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String       @unique
  passwordHash   String
  name           String
  cpf            String?
  phone          String?
  role           UserRole // admin | operator | producer | viewer
  isActive       Boolean      @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  contractsCreated Contract[]
  events           ContractEvent[]
  signatures       ContractSignature[]
}

model Contract {
  id             String         @id @default(cuid())
  tenantId       String // organizationId do comprador (cooperativa/trading)
  contractNumber String         @unique // auto-gerado: PLT-2025-0001
  cprNumber      String? // número da CPR — Fase 02
  cprType        CprType? // fisica | financeira — Fase 02
  status         ContractStatus @default(rascunho)

  // Partes
  sellerId    String // producer organization
  seller      Organization @relation("seller", fields: [sellerId], references: [id])
  buyerId     String // cooperative or trading organization
  buyer       Organization @relation("buyer", fields: [buyerId], references: [id])
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])

  // Objeto do contrato
  grainType     GrainType
  quantitySacks Decimal
  sackWeightKg  Decimal       @default(60)
  harvestYear   String // "2025/2026"
  harvestPeriod HarvestPeriod

  // Qualidade — padrões MAPA
  grainGrade          GrainGrade?
  maxMoisturePct      Decimal        @default(14.0)
  maxImpurityPct      Decimal        @default(1.0)
  minSpecificWeightGL Decimal?
  maxDamagedPct       Decimal?
  qualityAdjType      QualityAdjType

  // Preço e Pagamento
  priceType         PriceType
  priceValueCents   BigInt? // centavos (BRL) ou millicents (USD)
  priceCurrency     Currency       @default(BRL)
  priceAdjIndex     PriceAdjIndex?
  advancePct        Decimal? // % de adiantamento (barter)
  barterDescription String?

  // Entrega
  warehouseName        String
  warehouseAddress     Json
  deliveryDeadline     DateTime
  transportResponsible TransportResp

  // Penalidades
  penaltyPct       Decimal @default(10.0)
  hasWashoutClause Boolean @default(true)
  hasForceMajeure  Boolean @default(true)
  arbitrationForum String?

  // Assinatura / Blockchain (Fase 02 — null no MVP exceto contractHash)
  contractHash           String? // SHA-256 do JSON canônico do contrato
  blockchainTxHash       String? // Fase 02
  blockchainNetwork      String? // Fase 02
  blockchainContractAddr String? // Fase 02

  // Dados agronômicos / IoT / clima recebidos do campo (snapshot na criação)
  agronomicData      Json?

  // Datas de transição
  signedAt           DateTime?
  executionStartedAt DateTime?
  settledAt          DateTime?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  signatures        ContractSignature[]
  events            ContractEvent[]
  deliveries        Delivery[]
  blockchainRecords BlockchainRecord[]
  offer             Offer?

  @@index([tenantId, status])
  @@index([sellerId])
  @@index([buyerId])
  @@index([deliveryDeadline])
}

model ContractSignature {
  id                 String     @id @default(cuid())
  contractId         String
  contract           Contract   @relation(fields: [contractId], references: [id])
  userId             String
  user               User       @relation(fields: [userId], references: [id])
  signerRole         SignerRole // seller | buyer | witness
  ipAddress          String
  userAgent          String
  documentHashBefore String // SHA-256 do JSON canônico antes da assinatura
  documentHashAfter  String // SHA-256 do JSON canônico após registrar a assinatura
  signedAt           DateTime   @default(now())
}

model ContractEvent {
  id               String    @id @default(cuid())
  contractId       String
  contract         Contract  @relation(fields: [contractId], references: [id])
  eventType        EventType
  description      String
  performedById    String?
  performedBy      User?     @relation(fields: [performedById], references: [id])
  blockchainTxHash String? // Fase 02
  metadata         Json?
  createdAt        DateTime  @default(now())

  @@index([contractId, createdAt])
}

model Delivery {
  id                     String   @id @default(cuid())
  contractId             String
  contract               Contract @relation(fields: [contractId], references: [id])
  deliveryDate           DateTime
  quantitySacks          Decimal
  nfeKey                 String? // chave de acesso da NFe (44 dígitos)
  warehouseReceiptNumber String?

  // Qualidade medida na entrega
  moisturePct        Decimal?
  impurityPct        Decimal?
  specificWeightGL   Decimal?
  damagedPct         Decimal?
  qualityAccepted    Boolean?
  priceAdjustmentPct Decimal?

  // Pagamento (liberação manual no MVP)
  paymentAmountCents BigInt?
  paymentStatus      PaymentStatus @default(pendente)
  paymentReleasedAt  DateTime?
  pixTxId            String? // Fase 02

  blockchainTxHash String? // Fase 02
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  qualityReport QualityReport?

  @@index([contractId])
}

model QualityReport {
  id             String   @id @default(cuid())
  deliveryId     String   @unique
  delivery       Delivery @relation(fields: [deliveryId], references: [id])
  reportNumber   String
  laboratoryName String
  reportDate     DateTime

  // Análise (entrada manual no MVP)
  moisturePct      Decimal
  impurityPct      Decimal
  specificWeightGL Decimal?
  damagedPct       Decimal?
  greenPct         Decimal?
  brokenPct        Decimal?
  ardidosPct       Decimal?
  grade            GrainGrade

  fileUrl   String? // Fase 02 (upload de PDF) — null no MVP
  fileHash  String? // Fase 02 — null no MVP
  createdAt DateTime @default(now())
}

model BlockchainRecord {
  // Fase 02 — model criado, não populado no MVP
  id          String               @id @default(cuid())
  contractId  String
  contract    Contract             @relation(fields: [contractId], references: [id])
  recordType  BlockchainRecordType
  txHash      String               @unique
  blockNumber BigInt?
  network     String
  gasUsed     BigInt?
  data        Json?
  createdAt   DateTime             @default(now())

  @@index([contractId])
}

// Telemetria de campo (IoT) consolidada por cultura/safra — dados RECEBIDOS de
// colheitadeiras, tratores/plantadeiras, sensores de solo e estação meteorológica.
// A plataforma apenas recebe e armazena (não opera as máquinas).
model FieldReading {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  grainType     GrainType
  harvestYear   String // "2024/2025"
  harvestPeriod HarvestPeriod
  areaHa        Decimal // área monitorada (ha)

  // Colheitadeira (monitor de produtividade)
  yieldSacksPerHa       Decimal // produtividade (sc/ha)
  harvestMoisturePct    Decimal? // umidade do grão na colheita (%)
  harvestLossSacksPerHa Decimal? // perda estimada (sc/ha)

  // Plantio (trator/plantadeira)
  plantingDate         DateTime?
  plantPopulationPerHa Int?

  // Solo / vegetação
  soilMoisturePct Decimal?
  soilPh          Decimal?
  ndviAvg         Decimal? // índice de vegetação médio do ciclo (0–1)

  // Clima do ciclo (estação meteorológica)
  rainfallMmCycle Decimal? // chuva acumulada no ciclo (mm)
  gddCycle        Decimal? // graus-dia acumulados
  avgTempC        Decimal? // temperatura média (°C)
  frostEvents     Int? // nº de eventos de geada no ciclo

  // Detalhamento (mapa de produtividade, máquinas, clima estendido)
  machineData Json? // { harvester, tractor, fuelLPerHa, engineHours, speedKmh, headerWidthM }
  yieldMap    Json? // { minSc, maxSc, avgSc, zones }
  climateData Json? // métricas climáticas adicionais
  source      String? // origem dos dados (ex.: "John Deere Operations Center", "INMET")

  // Caderno de campo — operações recebidas de máquinas/apps de gestão
  // [{ date, type: plantio|adubacao|pulverizacao|colheita|outro, product, dosePerHa, unit, costCentsPerHa, source }]
  operations Json?

  // Análise de solo (laboratório) — além do pH/umidade dos sensores
  // { labName, sampleDate, pPpm, kCmolDm3, organicMatterPct, ctcCmolDm3, baseSaturationPct, recommendation }
  soilAnalysis Json?

  // Custo de produção consolidado (ERP/planilha do produtor ou benchmark regional)
  // { totalCostCentsPerHa, source, breakdown: { seedsCents, fertilizerCents, chemicalsCents, operationsCents, otherCents } }
  productionCost Json?

  // Armazenagem pós-colheita (termometria do silo)
  // { siloName, grainTempC, ambientTempC, aerationOn, capacitySacks, lastReadingAt }
  storage Json?

  // Ciclo de vida do lote pós-colheita
  status            LotStatus @default(colhido)
  storedMoisturePct Decimal? // umidade após secagem (% — apto se ≤ conservação)
  availableSacks    Decimal? // sacas disponíveis para venda

  collectedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  offers Offer[]

  @@index([organizationId, grainType, harvestYear])
}

// Oferta de venda criada pelo PRODUTOR a partir de um lote colhido e apto.
// A cooperativa/trading aceita a oferta e ela vira um Contract.
model Offer {
  id             String       @id @default(cuid())
  fieldReadingId String
  fieldReading   FieldReading @relation(fields: [fieldReadingId], references: [id])
  sellerId       String // organização do produtor
  seller         Organization @relation("offerSeller", fields: [sellerId], references: [id])

  grainType        GrainType
  harvestYear      String
  quantitySacks    Decimal
  askingPriceCents BigInt? // preço pedido (centavos/saca) — opcional
  status           OfferStatus @default(disponivel)
  notes            String?

  contractId String?   @unique // preenchido quando vira contrato
  contract   Contract? @relation(fields: [contractId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([sellerId])
}

// Enums
enum OrgType {
  cooperative
  trading
  producer
}

enum UserRole {
  admin
  operator
  producer
  viewer
}

enum ContractStatus {
  rascunho
  pendente_assinatura_comprador
  pendente_assinatura_produtor
  assinado
  em_execucao
  entregue_parcial
  disputado
  liquidado
  cancelado
}

enum CprType {
  fisica
  financeira
}

enum GrainType {
  soja
  milho
  cafe
  trigo
  algodao
  sorgo
  feijao
}

enum HarvestPeriod {
  primeira
  segunda
  unica
}

enum GrainGrade {
  T1
  T2
  T3
  fora_padrao
}

enum QualityAdjType {
  proportional
  fixed_pct
  rejection
  none
}

enum PriceType {
  fixo
  media_mercado
  indexado_b3
  indexado_cbot
}

enum Currency {
  BRL
  USD
}

enum PriceAdjIndex {
  IPCA
  IGPM
  none
}

enum TransportResp {
  seller
  buyer
}

enum SignerRole {
  seller
  buyer
  witness
}

enum EventType {
  criado
  assinado_comprador
  assinado_produtor
  em_execucao
  entregue
  entregue_parcial
  laudo_anexado
  pagamento_liberado
  pagamento_pago
  disputado
  cancelado
  hash_registrado_onchain
}

enum PaymentStatus {
  pendente
  liberado
  pago
}

enum BlockchainRecordType {
  contract_registered
  status_changed
  delivery_confirmed
  payment_released
  dispute_raised
}

enum PlanType {
  trial
  starter
  pro
  enterprise
}

// Ciclo de vida do lote: plantado → colhido → beneficiamento → disponível → ofertado → vendido
enum LotStatus {
  em_desenvolvimento
  colhido
  em_beneficiamento
  disponivel
  ofertado
  vendido
}

enum OfferStatus {
  disponivel
  em_negociacao
  contratada
  cancelada
}
