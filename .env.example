# =============================================================================
# Plantor — variáveis de ambiente (copie para .env e preencha)
# =============================================================================
# Cada app valida estas variáveis com Zod no startup:
#   - apps/api  → apps/api/src/config/env.schema.ts
#   - apps/web  → apps/web/src/env.ts
# Nunca faça commit do .env real. Não coloque segredos em variáveis NEXT_PUBLIC_*.

# -----------------------------------------------------------------------------
# Geral
# -----------------------------------------------------------------------------
NODE_ENV=development

# =============================================================================
# apps/api (NestJS)
# =============================================================================

# Porta da API
PORT=3001

# --- Banco de dados (Supabase / PostgreSQL) ---------------------------------
# DATABASE_URL: conexão com pooling (pgBouncer, porta 6543) usada em runtime.
# DIRECT_URL:   conexão direta (porta 5432) usada por `prisma migrate`.
# Pegue ambas em: Supabase → Project Settings → Database → Connection string.
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- JWT (Módulo 1) ---------------------------------------------------------
# Gere segredos fortes (>= 32 chars), ex: `openssl rand -base64 48`.
JWT_ACCESS_SECRET="troque-por-um-segredo-forte-de-32-ou-mais-caracteres"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="troque-por-outro-segredo-forte-de-32-ou-mais-caracteres"
JWT_REFRESH_EXPIRES_IN=7d

# --- Convite de produtor (magic link) ---------------------------------------
INVITE_TOKEN_TTL_HOURS=24

# --- Email transacional (Resend) — Módulo 1 ---------------------------------
# Crie a API key em https://resend.com. Opcional para subir a API, mas
# necessário para enviar convites/notificações.
RESEND_API_KEY=""
EMAIL_FROM="Plantor <no-reply@plantor.com.br>"

# --- URLs e CORS ------------------------------------------------------------
# URL pública do app web (usada em links de email).
APP_WEB_URL="http://localhost:3000"
# Lista explícita de origens permitidas (separadas por vírgula) — nunca "*".
CORS_ORIGINS="http://localhost:3000"

# --- Rate limiting (NestJS Throttler) ---------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# --- Observabilidade (opcional no MVP) --------------------------------------
SENTRY_DSN=""

# --- IA (Google Gemini) — features do produtor ------------------------------
# Sem a chave, "Entenda em linguagem simples" usa um resumo determinístico e a
# assistente fica desativada. Com a chave, usam o Gemini (gemini-2.5-flash).
# Crie em https://aistudio.google.com/apikey (Google AI Studio).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# =============================================================================
# apps/web (Next.js)
# =============================================================================

# URL base da API NestJS (inclui o prefixo /api). Exposta ao browser.
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# --- NextAuth.js v5 / Auth.js (Módulo 1) ------------------------------------
# Gere com `openssl rand -base64 32`. O v5 usa AUTH_SECRET (NEXTAUTH_SECRET
# também é aceito como fallback).
AUTH_SECRET="troque-por-um-segredo-do-nextauth"
NEXTAUTH_URL="http://localhost:3000"
